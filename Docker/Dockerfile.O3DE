ARG ROS_DISTRO=rolling
FROM ros:${ROS_DISTRO}

# Re-declare ARG after FROM so it is available in the rest of the build
ARG ROS_DISTRO
ENV ROS_DISTRO=${ROS_DISTRO}

ENV WORKSPACE=/data/workspace

WORKDIR $WORKSPACE

ENV LANG=en_US.UTF-8

# Setup time zone and locale data (necessary for SSL and HTTPS packages)
RUN apt-get update \
    && DEBIAN_FRONTEND="noninteractive" apt-get -y install tzdata locales keyboard-configuration curl \
    && sed -i -e 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
    && dpkg-reconfigure --frontend=noninteractive locales \
    && update-locale LANG=en_US.UTF-8 \
    && sh -c 'echo "deb [arch=amd64,arm64] http://repo.ros2.org/ubuntu/main `lsb_release -cs` main" > /etc/apt/sources.list.d/ros2-latest.list' \
    && curl -s https://raw.githubusercontent.com/ros/rosdistro/master/ros.asc | sudo apt-key add - \
    && rm -rf /var/lib/apt/lists/*

# Install the required ubuntu packages
RUN apt-get update \
    && apt-get install -y \
    binutils \
    clang \
    cmake \
    git \
    git-lfs \
    libglu1-mesa-dev \
    libxcb-xinerama0 \
    libfontconfig1-dev \
    libnvidia-gl-470 \
    libxcb-xkb-dev \
    libxkbcommon-x11-dev \
    libxkbcommon-dev \
    libxcb-xfixes0-dev \
    libxcb-xinput-dev \
    libxcb-xinput0 \
    libpcre2-16-0 \
    libunwind-dev \
    ninja-build \
    python3-pip \
    software-properties-common \
    ros-${ROS_DISTRO}-ackermann-msgs \
    ros-${ROS_DISTRO}-control-toolbox \
    ros-${ROS_DISTRO}-xacro \
    ros-${ROS_DISTRO}-vision-msgs \
    ros-${ROS_DISTRO}-cyclonedds \
    ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
    ros-${ROS_DISTRO}-controller-manager

# Ubuntu 22.04 (humble) ships CMake 3.22; upgrade to 3.28 via the Kitware APT repo
RUN if [ "${ROS_DISTRO}" = "humble" ]; then \
    curl -fsSL https://apt.kitware.com/keys/kitware-archive-latest.asc \
        | gpg --dearmor - > /usr/share/keyrings/kitware-archive-keyring.gpg \
    && echo 'deb [signed-by=/usr/share/keyrings/kitware-archive-keyring.gpg] https://apt.kitware.com/ubuntu/ jammy main' \
        > /etc/apt/sources.list.d/kitware.list \
    && apt-get update \
    && apt-get install -y "cmake=3.28.*" "cmake-data=3.28.*" \
    && rm -rf /var/lib/apt/lists/*; \
    fi

ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Install O3DE from pre-downloaded .deb package
# Place tmp/o3de_latest.deb in the repo root before building (see README for download URL)
COPY tmp/o3de_latest.deb /tmp/o3de_latest.deb
RUN apt-get update \
    && apt-get install -y /tmp/o3de_latest.deb \
    && rm /tmp/o3de_latest.deb \
    && rm -rf /var/lib/apt/lists/*

# Bootstrap O3DE Python, then register the engine
RUN /opt/O3DE/26.05/python/get_python.sh \
    && /opt/O3DE/26.05/scripts/o3de.sh register --this-engine

# Install build scripts
COPY Docker/build_project.sh /usr/local/bin/build_project.sh
COPY Docker/build_ros_ws.sh /usr/local/bin/build_ros_ws.sh
RUN chmod +x /usr/local/bin/build_project.sh /usr/local/bin/build_ros_ws.sh

ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=all
ENTRYPOINT ["/bin/bash", "-c"]
